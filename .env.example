# Copy to .env. Local development needs only DEEPSEEK_API_KEY, or COMMITTEE=off.

# The networks the app offers, comma-separated, default first.
# Available: local, sepolia, baseSepolia, monadTestnet, mainnet, base, monad
# Add more chains in web/src/chain/networks.ts.
NEXT_PUBLIC_NETWORKS=local

# The address visitors use, for links in shared previews.
APP_URL=

# The account that deploys the contracts, puts the first money into the fund, posts the
# partners' bonds, pays for the relayer and the faucet, and tops up the partners' gas.
# `pnpm keygen` writes one and prints its address, which you then fund.
OPERATOR_PRIVATE_KEY=

# The four partners' keys, comma-separated, in seat order: product, technology, tokenomics,
# risk. The server votes with them. `pnpm keygen` writes four.
PARTNER_KEYS=

# The address that receives the shares of the fund's first deposit, and with them the say
# over vetoes. Set it before the first deployment to a live network.
INVESTOR=

# The model the partners run on, as <provider>/<model> in the pi-ai catalog, and its key.
# PARTNER_MODEL=deepseek/deepseek-flash
DEEPSEEK_API_KEY=

# The server runs the partners while this is on. When several instances serve the app, set
# it to off on all but one of them. Off, the app runs without a model key.
# COMMITTEE=off

# The Postgres server that holds the indexed history and the partners' notes. Without one
# the app runs Postgres inside its own process and keeps the files in web/.data, which suits
# a single server.
# DATABASE_URL=postgres://user:password@host:5432/database

# Shows addresses by their ENS name and avatar. Names are looked up on Ethereum mainnet
# whatever networks the app offers. The public endpoint is used unless RPC_URLS_MAINNET names another.
# NEXT_PUBLIC_ENS=on

# Pitches, milestone reports, opinions and terms are kept in web/.data/files. To keep them in
# IPFS instead, name the RPC address of a Kubo node. Never expose that port to the internet.
# IPFS_API_URL=http://127.0.0.1:5001

# Where ipfs:// files this server does not hold itself are fetched from.
# IPFS_GATEWAY_URL=https://ipfs.io

# The server copies the committee's and the fund's events into the database as it runs. When
# several instances serve the app, set this to off on all but one of them.
# INDEXER=off

# RPC endpoints per network, comma-separated, replacing the public defaults. They stay on the
# server, so URLs that carry a provider key are safe here. The name is RPC_URLS_ followed by
# the network in upper snake case. A crowd sending pitches at once outgrows the public Monad
# endpoints' rate limit, so give the testnet an endpoint of your own.
# RPC_URLS_MONAD_TESTNET=

# Extra flags for the local chain.
# ANVIL_ARGS=--network monad
# ANVIL_ARGS=--fork-url https://testnet-rpc.monad.xyz
